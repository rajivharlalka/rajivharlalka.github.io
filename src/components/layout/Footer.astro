---
import { menuLinks, siteConfig } from "@/site-config";

const year = new Date().getFullYear();
---

<footer
	class="mt-auto flex w-full flex-col items-center justify-center gap-y-2 pb-6 pt-24 text-center align-top text-sm text-textColor/50 sm:flex-row sm:justify-between"
>
	<div class="me-0 sm:me-4">
		&copy; {siteConfig.author}
		{year}.
	</div>
	<nav
		aria-label="More on this site"
		class="flex gap-x-2 sm:gap-x-0 sm:divide-x sm:divide-textColor/20"
	>
		{
			menuLinks.map((link) => (
				<a class="font-sans px-4 py-2 sm:py-0 transition-colors hover:text-textColor sm:hover:underline" href={link.path}>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
